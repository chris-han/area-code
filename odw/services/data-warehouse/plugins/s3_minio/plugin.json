{
  "name": "s3-minio-csv",
  "display_name": "S3/MinIO CSV Data Source",
  "description": "S3/MinIO CSV data source plugin for billing data extraction with automatic schema detection and FOCUS transformation support",
  "version": "1.0.0",
  "author": "bia Team",
  "category": "data_source",
  "plugin_type": "data_source",
  "entry_point": "plugin.py",
  "tags": ["s3", "minio", "csv", "billing", "storage", "aws", "object-storage"],
  "requirements": [
    "boto3>=1.26.0",
    "pandas>=1.5.0",
    "botocore>=1.29.0"
  ],
  "license": "MIT",
  "icon_url": "https://aws.amazon.com/favicon.ico",
  "documentation_url": "https://boto3.amazonaws.com/v1/documentation/api/latest/index.html",
  "repository_url": "https://github.com/bia-team/s3-minio-plugin",
  "config_schema": {
    "type": "object",
    "properties": {
      "endpoint_url": {
        "type": ["string", "null"],
        "description": "S3 endpoint URL (null for AWS S3, URL for MinIO)",
        "examples": ["http://localhost:9000", "https://s3.amazonaws.com", null]
      },
      "access_key_id": {
        "type": "string",
        "description": "S3 access key ID for authentication"
      },
      "secret_access_key": {
        "type": "string",
        "description": "S3 secret access key for authentication",
        "format": "password"
      },
      "region_name": {
        "type": "string",
        "default": "us-east-1",
        "description": "S3 region name"
      },
      "bucket_name": {
        "type": "string",
        "description": "S3 bucket name containing CSV billing files"
      },
      "use_ssl": {
        "type": "boolean",
        "default": true,
        "description": "Use SSL/TLS for connections"
      },
      "file_pattern": {
        "type": "string",
        "default": "*.csv",
        "description": "File pattern to match CSV files (glob pattern)"
      },
      "batch_size": {
        "type": "integer",
        "default": 1000,
        "minimum": 100,
        "maximum": 10000,
        "description": "Number of records to process in each batch"
      },
      "max_file_size_mb": {
        "type": "integer",
        "default": 100,
        "minimum": 1,
        "maximum": 1000,
        "description": "Maximum file size to process (MB)"
      },
      "encoding": {
        "type": "string",
        "default": "utf-8",
        "enum": ["utf-8", "latin-1", "cp1252", "iso-8859-1"],
        "description": "File encoding for CSV files"
      },
      "prefix": {
        "type": "string",
        "description": "Optional prefix to filter files in bucket"
      },
      "auto_detect_schema": {
        "type": "boolean",
        "default": true,
        "description": "Automatically detect CSV schema and data types"
      }
    },
    "required": ["access_key_id", "secret_access_key", "bucket_name"]
  },
  "default_config": {
    "region_name": "us-east-1",
    "use_ssl": true,
    "file_pattern": "*.csv",
    "batch_size": 1000,
    "max_file_size_mb": 100,
    "encoding": "utf-8",
    "auto_detect_schema": true
  }
}