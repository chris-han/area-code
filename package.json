{
  "name": "area-code",
  "version": "0.3.0",
  "private": true,
  "workspaces": [
    "ufa/apps/*",
    "ufa/packages/*",
    "ufa/services/*",
    "ufa-lite/apps/*",
    "ufa-lite/services/*",
    "odw/apps/*",
    "odw/packages/*",
    "odw/services/*",
    "bia_admin",
    "bia_admin/bia-frontend"
  ],
  "scripts": {
    "ufa:dev": "./scripts/run-ufa-dev.sh",
    "ufa:dev:clean": "turbo run ufa:dev:clean && find . -name 'node_modules' -type d -exec rm -rf {} + && find . -name '.moose' -type d -exec rm -rf {} + && find . -name '.ts-node' -type d -exec rm -rf {} +",
    "ufa:dev:seed": "./ufa/scripts/dev-seed.sh",
    "ufa:dev:seed:transactional-supabase-foobar": "./ufa/scripts/dev-seed.sh --service=transactional-supabase-foobar",
    "ufa:dev:seed:analytical-moose-foobar": "./ufa/scripts/dev-seed.sh --service=analytical-moose-foobar",
    "ufa:dev:seed:retrieval-elasticsearch-foobar": "./ufa/scripts/dev-seed.sh --service=retrieval-elasticsearch-foobar",
    "ufa-lite:dev": "NODE_ENV=development turbo run ufa-lite:dev --ui=tui",
    "ufa-lite:dev:clean": "turbo run ufa-lite:dev:clean && find . -name 'node_modules' -type d -exec rm -rf {} + && find . -name '.moose' -type d -exec rm -rf {} + && find . -name '.ts-node' -type d -exec rm -rf {} +",
    "odw:dev": "turbo run odw:dev --ui=tui",
    "odw:dev:clean": "turbo run odw:dev:clean",
    "odw:dev:seed": "./odw/scripts/dev-seed.sh",
    "bia:dev": "ABI_SKIP_PATTERN_KILL=1 ./bia_admin/scripts/free-ports.sh && turbo run bia:dev --filter=@workspace/bia-frontend --filter=@workspace/bia-admin --ui=tui",
    "bia:dev:clean": "./bia_admin/scripts/free-ports.sh"
  },
  "devDependencies": {
    "@turbo/gen": "^1.13.4",
    "eslint": "^8.57.1",
    "prettier": "^3.6.2",
    "turbo": "^2.5.4",
    "typescript": "5.9.2"
  },
  "packageManager": "bun@1.2.21",
  "engines": {
    "node": ">=18",
    "bun": ">=1.0.0"
  }
}
